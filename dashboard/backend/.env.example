# Copy to .env on the website host. Never commit the real .env file.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1546125037545988207
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN.example/auth/callback
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
COOKIE_HTTPS_ONLY=true

# Set this after you provide the Media role ID.
MEDIA_ROLE_ID=

# Map Discord role IDs to access classes.
# Example: {"ROLE_ID":"admin","ANOTHER_ROLE_ID":"media"}
ROLE_ACCESS_MAP={}

# Optional Discord user IDs with full owner access, comma-separated.
OWNER_USER_IDS=
