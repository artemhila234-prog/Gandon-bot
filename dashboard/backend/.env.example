# GastWorld Control Panel backend. Never commit the real .env file.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1492974397001171176
DISCORD_REDIRECT_URI=https://media.apps.bot-hosting.cloud/auth/callback
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
COOKIE_HTTPS_ONLY=true

# Shared secret used by the bot to securely send access-role IDs to this API.
BOT_SYNC_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Bot API connection (required when the panel backend runs separately).
BOT_API_URL=https://YOUR-BOT-HOST.example
BOT_DATA_API_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Persistent panel database path.
PANEL_DB_PATH=panel.db

# TikTok Login Kit + Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://media.apps.bot-hosting.cloud/tiktok/callback
# The SAME Fernet key must be configured on the bot and panel hosts.
TIKTOK_TOKEN_ENCRYPTION_KEY=
