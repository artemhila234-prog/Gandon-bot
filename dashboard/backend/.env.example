# Copy to .env on the website host. Never commit the real .env file.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1546125037545988207
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN.example/auth/callback
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
COOKIE_HTTPS_ONLY=true

# Shared secret used by the bot to securely send newly-created Discord role IDs to this API.
# Set the same random value as CONTROL_PANEL_SYNC_SECRET in Bot-Hosting.
BOT_SYNC_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Optional persistent database path. Keep this file on persistent storage.
PANEL_DB_PATH=panel.db
